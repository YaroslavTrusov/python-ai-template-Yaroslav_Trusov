# Извлекаем самолёты с указанием двигателя, максимальной высоты, цены, количества произведённых самолетов, страны происхождения, дыты первого полета и производителя
# We extract aircraft with engine, maximum altitude, price, number of aircraft produced, country of origin, date of first flight, and manufacturer
SELECT DISTINCT
  ?aircraft ?aircraftLabel
  ?engine ?engineLabel
  ?maxAltitude
  ?price
  ?totalProduced
  ?firstFlight
  ?countryLabel
  ?manufacturerLabel
WHERE {
  VALUES ?aircraftType { wd:Q15056993 wd:Q11436 }  # Семейство самолётов или модель самолёта

  ?aircraft wdt:P31/wdt:P279* ?aircraftType;
            wdt:P516 ?engine;               # Двигатель (powered by)
            wdt:P1092 ?totalProduced.       # Количество произведённых самолётов

  OPTIONAL { ?aircraft wdt:P2254 ?maxAltitude. } # Максимальная высота
  OPTIONAL { ?aircraft wdt:P2284 ?price. }       # Стоимость
  OPTIONAL { ?aircraft wdt:P495 ?country. }      # Страна происхождения (только метка)
  OPTIONAL { ?aircraft wdt:P606 ?firstFlight. }  # Дата первого полёта
  OPTIONAL { ?aircraft wdt:P176 ?manufacturer. } # Производитель (только метка)

  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru,en". }
}
ORDER BY DESC(?totalProduced)
