# Поиск производителей двигателей, используемых в самолётах, с метками страны и штаб-квартиры
#Search for manufacturers of aircraft engines, with country and headquarters tags
SELECT DISTINCT
  ?manufacturer ?manufacturerLabel
  ?countryLabel
  ?headquartersLabel
  ?coordinates
WHERE {
  ?aircraft wdt:P516 ?engine.  # Двигатель используется в самолёте (powered by)
  ?engine wdt:P176 ?manufacturer.  # Производитель двигателя
  ?manufacturer wdt:P17 ?country.   # Страна производителя

  OPTIONAL { ?manufacturer wdt:P159 ?headquarters. }  # Штаб-квартира (опционально)
  OPTIONAL { ?manufacturer wdt:P625 ?coordinates. }   # Координаты штаб-квартиры (опционально)

  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru,en". }
}
ORDER BY ?manufacturerLabel
